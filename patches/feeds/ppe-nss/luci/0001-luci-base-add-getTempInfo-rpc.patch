+	getTempInfo: {
+		call: function() {
+			let result = {};
+
+			// Hottest NSS thermal zone; sysfs reports millidegrees Celsius.
+			// Kept independent of /sbin/tempinfo so it also works on images
+			// where that helper is not installed.
+			const nssfd = popen("for z in /sys/class/thermal/thermal_zone*; do grep -q '^nss' \"$z/type\" && cat \"$z/temp\"; done 2>/dev/null | sort -n | tail -n 1 | awk '$1 ~ /^[0-9]+$/ && $1 > 0 { printf \"%d\", int($1 / 1000 + 0.5) }'");
+			if (nssfd) {
+				let nsstemp = nssfd.read('all');
+				nssfd.close();
+				if (nsstemp && trim(nsstemp) != '')
+					result.nsstemp = trim(nsstemp);
+			}
+
+			// CPU/Wi-Fi temperature and CPU frequency, inlined from autocore's
+			// /sbin/tempinfo and /sbin/cpuinfo so the image needs no helper.
+			// Reads thermal_zone0, ieee80211 hwmon and cpufreq policy0 sysfs.
+			const tfd = popen("c=$(cat /sys/class/thermal/thermal_zone0/temp 2>/dev/null | awk '{printf \"%.1f°C\", $0/1000}'); w=$(cat /sys/class/ieee80211/*/hwmon*/temp1_input 2>/dev/null | awk '{printf \"%.1f°C \", $0/1000}'); f=$(for p in /sys/devices/system/cpu/cpufreq/policy0/cpuinfo_cur_freq /sys/devices/system/cpu/cpu0/cpufreq/cpuinfo_cur_freq; do [ -r \"$p\" ] && cat \"$p\" && break; done 2>/dev/null | awk '{printf \"%.0fMHz\", $0/1000}'); if [ -n \"$c\" ] && [ -n \"$w\" ]; then t=\"CPU: $c WiFi: $w\"; elif [ -n \"$c\" ]; then t=\"CPU: $c\"; elif [ -n \"$w\" ]; then t=\"WiFi: $w\"; else t=\"No temperature info\"; fi; [ -n \"$f\" ] && t=\"${t% } · $f\"; printf '%s' \"$t\"");
+			if (tfd) {
+				let tempinfo = tfd.read('all');
+				tfd.close();
+				if (!tempinfo)
+					tempinfo = '?';
+				result.tempinfo = tempinfo;
+			} else {
+				result.tempinfo = error();
+			}
+
+			return result;
+		}
+	},
